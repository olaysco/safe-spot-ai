{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "name": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "databasePassword": {
      "value": "${AZURE_POSTGRES_PASSWORD}"
    },
    "image": {
      "value": "${SERVICE_WORKER_IMAGE_NAME}"
    },
    "environmentId": {
      "value": "${AZURE_CONTAINER_ENVIRONMENT_ID}"
    },
    "appUrl": {
      "value": "${SERVICE_WEB_URI}"
    },
    "identityId": {
      "value": "${AZURE_IDENTITY_ID}"
    },
    "identityClientId": {
      "value": "${AZURE_IDENTITY_CLIENT_ID}"
    },
    "registryEndpoint": {
      "value": "${AZURE_CONTAINER_REGISTRY_ENDPOINT}"
    },
    "storageUrl": {
      "value": "${AZURE_STORAGE_ACCOUNT_URL}"
    },
    "databaseHost": {
      "value": "${AZURE_POSTGRES_HOST}"
    },
    "aiEndpoint": {
      "value": "${AZURE_AI_ENDPOINT=}"
    },
    "aiTextDeployment": {
      "value": "${AZURE_AI_TEXT_DEPLOYMENT=}"
    },
    "emailEndpoint": {
      "value": "${ZEPTOMAIL_API_URL=}"
    },
    "emailSender": {
      "value": "${ZEPTOMAIL_FROM=}"
    },
    "demoEmailTo": {
      "value": "${DEMO_EMAIL_TO=}"
    },
    "emailApiKey": {
      "value": "${ZEPTOMAIL_API_KEY=}"
    }
  }
}
