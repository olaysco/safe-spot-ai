# Use PostgreSQL for a shared deployment.
DATABASE_URL=sqlite:///.local/safespot.db
PUBLIC_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
WORKER_ENABLED=true
# Local capture is the default. No email leaves the application.
EMAIL_MODE=capture
# Use zeptomail for ZeptoMail or smtp for an SMTP server.
# Copy the full HTTPS email URL from the ZeptoMail SMTP/API page.
ZEPTOMAIL_API_URL=
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=safespot@example.test
MANAGER_EMAIL=manager@example.test
# Use the Azure OpenAI endpoint with the /openai/v1 path.
TEXT_AI_BASE_URL=
# Enter the Azure deployment name.
TEXT_AI_MODEL=gpt-5-mini
TEXT_AI_API_KEY=
TEXT_AI_AUTH_MODE=api_key
# Azure deployments use entra authentication through managed identity.
SMTP_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Compose requires a generated URL-safe database password.
POSTGRES_PASSWORD=
# Azure uses managed identity for private evidence storage.
STORAGE_BACKEND=local
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=evidence
AZURE_CLIENT_ID=
