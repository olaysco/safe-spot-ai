# Use PostgreSQL for a shared deployment.
DATABASE_URL=sqlite:///.local/safespot.db
PUBLIC_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
WORKER_ENABLED=true
# Local capture is the default. No email leaves the application.
EMAIL_MODE=capture
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=safespot@example.test
MANAGER_EMAIL=manager@example.test
# Configure a Microsoft-Decision-1 deployment to enable AI triage.
DECISION_ENDPOINT=
DECISION_DEPLOYMENT=
DECISION_API_KEY=
# Configure a Phi service with an OpenAI-compatible chat endpoint.
TEXT_AI_BASE_URL=
TEXT_AI_MODEL=Phi-4-multimodal-instruct
TEXT_AI_API_KEY=
